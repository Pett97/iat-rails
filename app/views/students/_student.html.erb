<div id="<%= dom_id student %>">
  <div>
    <strong>Cpf:</strong>
    <%= student.cpf %>
  </div>

  <div>
    <strong>Name:</strong>
    <%= student.name %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= student.email %>
  </div>

  <div>
    <strong>Cep:</strong>
    <%= student.cep %>
  </div>

  <div>
    <strong>State:</strong>
    <%= student.state %>
  </div>

  <div>
    <strong>City:</strong>
    <%= student.city %>
  </div>

  <div>
    <strong>Number:</strong>
    <%= student.number %>
  </div>

  <div>
    <strong>Address:</strong>
    <%= student.address %>
  </div>

  <div>
    <strong>Date of birth:</strong>
    <%= student.date_of_birth %>
  </div>

</div>
